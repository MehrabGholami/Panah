<?xml version="1.0" encoding="UTF-8"?>
<!--
  فرآیند چرخه عمر مأموریت در سامانه پناه
  استاندارد BPMN 2.0
  خطوط شنا: هماهنگ‌کننده، سامانه پناه، داوطلب
  وضعیت‌های مأموریت: draft, published, in_progress, completed, closed
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_MissionLifecycle"
                  targetNamespace="http://panah.local/bpmn"
                  exporter="Panah SRS Documentation"
                  exporterVersion="1.0">

  <bpmn:collaboration id="Collaboration_MissionLifecycle">
    <bpmn:participant id="Participant_Panah" name="سامانه مدیریت بحران و داوطلبان پناه" processRef="Process_MissionLifecycle" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MissionLifecycle" name="چرخه عمر مأموریت" isExecutable="false">

    <bpmn:laneSet id="LaneSet_MissionLifecycle">
      <bpmn:lane id="Lane_Coordinator" name="هماهنگ‌کننده">
        <bpmn:flowNodeRef>StartEvent_DisasterRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineRequiredSkills</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReadyToPublish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KeepDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RemainsDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteMissionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseMission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MissionClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="سامانه پناه">
        <bpmn:flowNodeRef>Task_PublishMission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BroadcastNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MissionStartTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CapacityReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_StartTimeReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartMission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteMission</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Volunteer" name="داوطلب">
        <bpmn:flowNodeRef>Task_ApplyForMission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RespondToAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssignmentResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinishWork</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_DisasterRegistered" name="رویداد بحران فعال ثبت شده است">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_CreateMission" name="ایجاد مأموریت در وضعیت پیش‌نویس">
      <bpmn:documentation>ثبت عنوان، شرح، اولویت، موقعیت، زمان شروع و پایان، تعداد نیروی مورد نیاز، تجهیزات و نکات ایمنی</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DefineRequiredSkills" name="تعیین مهارت‌های الزامی و اختیاری مأموریت">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ReadyToPublish" name="مأموریت آماده انتشار است" default="Flow_04">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:manualTask id="Task_KeepDraft" name="نگه‌داشتن مأموریت در پیش‌نویس برای تکمیل بعدی">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:endEvent id="EndEvent_RemainsDraft" name="مأموریت در پیش‌نویس ماند">
      <bpmn:incoming>Flow_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_PublishMission" name="انتشار مأموریت و فعال‌سازی پذیرش درخواست">
      <bpmn:documentation>تغییر وضعیت به published و فعال‌سازی پرچم نمایش به داوطلبان و پرچم پذیرش درخواست همکاری و ثبت رکورد حسابرسی</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_BroadcastNotification" name="اعلان مأموریت جدید به داوطلبان واجد شرایط">
      <bpmn:documentation>تعیین گیرندگان بر پایه مهارت و موقعیت، درج اعلان درون‌برنامه‌ای و انتشار وظیفه ارسال ایمیل گروهی در صف Redis</bpmn:documentation>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_ApplyForMission" name="ارسال درخواست همکاری توسط داوطلب">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReviewApplications" name="بررسی درخواست‌ها و ایجاد تخصیص">
      <bpmn:documentation>بررسی مهارت و دسترس‌پذیری داوطلب و ثبت تصمیم تأیید یا رد یا فهرست انتظار و ایجاد رکورد تخصیص برای درخواست تأییدشده</bpmn:documentation>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RespondToAssignment" name="پاسخ داوطلب به تخصیص">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AssignmentResponse" name="پاسخ داوطلب چیست" default="Flow_12">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:eventBasedGateway id="Gateway_MissionStartTrigger" name="محرک آغاز مأموریت" instantiate="false" eventGatewayType="Exclusive">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_CapacityReached" name="ظرفیت نیروی مورد نیاز تکمیل شد">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_Capacity">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">شمار تخصیص‌های پذیرفته‌شده برابر مقدار فیلد required_volunteers است</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_StartTimeReached" name="زمان شروع مأموریت فرا رسید">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_StartTime">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">مقدار فیلد start_time مأموریت</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_StartMission" name="تغییر وضعیت مأموریت به در حال اجرا">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_CheckIn" name="ثبت حضور داوطلب در محل مأموریت">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_FinishWork" name="اجرای عملیات میدانی و اعلام پایان کار">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_CompleteMission" name="تغییر وضعیت مأموریت به تکمیل‌شده">
      <bpmn:documentation>پس از تعیین وضعیت نهایی همه تخصیص‌ها، وضعیت مأموریت به completed تغییر می‌یابد و اعلان آمادگی ثبت گزارش ارسال می‌شود</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_WriteMissionReport" name="ثبت گزارش مأموریت و بارگذاری پیوست‌ها">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CloseMission" name="بازبینی گزارش و بستن مأموریت">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_MissionClosed" name="مأموریت بسته شد">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_DisasterRegistered" targetRef="Task_CreateMission" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CreateMission" targetRef="Task_DefineRequiredSkills" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DefineRequiredSkills" targetRef="Gateway_ReadyToPublish" />
    <bpmn:sequenceFlow id="Flow_04" name="خیر" sourceRef="Gateway_ReadyToPublish" targetRef="Task_KeepDraft" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_KeepDraft" targetRef="EndEvent_RemainsDraft" />
    <bpmn:sequenceFlow id="Flow_06" name="بله" sourceRef="Gateway_ReadyToPublish" targetRef="Task_PublishMission" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_PublishMission" targetRef="Task_BroadcastNotification" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_BroadcastNotification" targetRef="Task_ApplyForMission" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ApplyForMission" targetRef="Task_ReviewApplications" />
    <bpmn:sequenceFlow id="Flow_10" name="تخصیص ایجاد شد" sourceRef="Task_ReviewApplications" targetRef="Task_RespondToAssignment" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RespondToAssignment" targetRef="Gateway_AssignmentResponse" />
    <bpmn:sequenceFlow id="Flow_12" name="رد تخصیص و آزادسازی ظرفیت" sourceRef="Gateway_AssignmentResponse" targetRef="Task_ReviewApplications" />
    <bpmn:sequenceFlow id="Flow_13" name="پذیرش تخصیص" sourceRef="Gateway_AssignmentResponse" targetRef="Gateway_MissionStartTrigger" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_MissionStartTrigger" targetRef="Event_CapacityReached" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_MissionStartTrigger" targetRef="Event_StartTimeReached" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Event_CapacityReached" targetRef="Task_StartMission" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_StartTimeReached" targetRef="Task_StartMission" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_StartMission" targetRef="Task_CheckIn" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CheckIn" targetRef="Task_FinishWork" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_FinishWork" targetRef="Task_CompleteMission" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CompleteMission" targetRef="Task_WriteMissionReport" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_WriteMissionReport" targetRef="Task_CloseMission" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_CloseMission" targetRef="EndEvent_MissionClosed" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_MissionLifecycle">
    <bpmndi:BPMNPlane id="BPMNPlane_MissionLifecycle" bpmnElement="Collaboration_MissionLifecycle">

      <bpmndi:BPMNShape id="Shape_Participant_Panah" bpmnElement="Participant_Panah" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2260" height="600" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Coordinator" bpmnElement="Lane_Coordinator" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2230" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="2230" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Volunteer" bpmnElement="Lane_Volunteer" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="2230" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_DisasterRegistered" bpmnElement="StartEvent_DisasterRegistered">
        <dc:Bounds x="242" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="222" y="205" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CreateMission" bpmnElement="Task_CreateMission">
        <dc:Bounds x="320" y="140" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_DefineRequiredSkills" bpmnElement="Task_DefineRequiredSkills">
        <dc:Bounds x="510" y="140" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ReadyToPublish" bpmnElement="Gateway_ReadyToPublish" isMarkerVisible="true">
        <dc:Bounds x="700" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="105" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_KeepDraft" bpmnElement="Task_KeepDraft">
        <dc:Bounds x="790" y="140" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_RemainsDraft" bpmnElement="EndEvent_RemainsDraft">
        <dc:Bounds x="980" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="205" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_PublishMission" bpmnElement="Task_PublishMission">
        <dc:Bounds x="700" y="340" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_BroadcastNotification" bpmnElement="Task_BroadcastNotification">
        <dc:Bounds x="890" y="340" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ApplyForMission" bpmnElement="Task_ApplyForMission">
        <dc:Bounds x="1040" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ReviewApplications" bpmnElement="Task_ReviewApplications">
        <dc:Bounds x="1240" y="140" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_RespondToAssignment" bpmnElement="Task_RespondToAssignment">
        <dc:Bounds x="1240" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_AssignmentResponse" bpmnElement="Gateway_AssignmentResponse" isMarkerVisible="true">
        <dc:Bounds x="1440" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1420" y="612" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_MissionStartTrigger" bpmnElement="Gateway_MissionStartTrigger">
        <dc:Bounds x="1440" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1420" y="412" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_CapacityReached" bpmnElement="Event_CapacityReached">
        <dc:Bounds x="1540" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1520" y="290" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_StartTimeReached" bpmnElement="Event_StartTimeReached">
        <dc:Bounds x="1540" y="404" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1520" y="442" width="90" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_StartMission" bpmnElement="Task_StartMission">
        <dc:Bounds x="1630" y="340" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CheckIn" bpmnElement="Task_CheckIn">
        <dc:Bounds x="1630" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_FinishWork" bpmnElement="Task_FinishWork">
        <dc:Bounds x="1830" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CompleteMission" bpmnElement="Task_CompleteMission">
        <dc:Bounds x="1830" y="340" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_WriteMissionReport" bpmnElement="Task_WriteMissionReport">
        <dc:Bounds x="1830" y="140" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CloseMission" bpmnElement="Task_CloseMission">
        <dc:Bounds x="2060" y="140" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_MissionClosed" bpmnElement="EndEvent_MissionClosed">
        <dc:Bounds x="2290" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2270" y="205" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="278" y="180" />
        <di:waypoint x="320" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="470" y="180" />
        <di:waypoint x="510" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="660" y="180" />
        <di:waypoint x="700" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="750" y="180" />
        <di:waypoint x="790" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="752" y="150" width="40" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="940" y="180" />
        <di:waypoint x="980" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="725" y="205" />
        <di:waypoint x="725" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="730" y="260" width="40" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="850" y="380" />
        <di:waypoint x="890" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1000" y="420" />
        <di:waypoint x="1000" y="580" />
