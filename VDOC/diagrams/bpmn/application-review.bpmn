<?xml version="1.0" encoding="UTF-8"?>
<!--
  فرآیند بررسی درخواست همکاری داوطلب در مأموریت
  استاندارد BPMN 2.0 با دو استخر و جریان‌های پیام میان آن‌ها
  استخر یک: داوطلب
  استخر دو: سامانه پناه با خطوط شنای سرویس API، هماهنگ‌کننده و کارگر نامتقارن
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ApplicationReview"
                  targetNamespace="http://panah.local/bpmn"
                  exporter="Panah SRS Documentation"
                  exporterVersion="1.0">

  <bpmn:message id="Message_ApplicationSubmitted" name="درخواست همکاری داوطلب" />
  <bpmn:message id="Message_ReviewResult" name="اعلان نتیجه بررسی درخواست" />

  <bpmn:collaboration id="Collaboration_ApplicationReview">
    <bpmn:participant id="Participant_Volunteer" name="داوطلب" processRef="Process_Volunteer" />
    <bpmn:participant id="Participant_Panah" name="سامانه پناه" processRef="Process_Panah" />
    <bpmn:messageFlow id="MessageFlow_Submit" name="ارسال درخواست همکاری با فراخوانی نقطه پایانی REST"
                      sourceRef="Task_SubmitApplication" targetRef="Event_ApplicationReceived"
                      messageRef="Message_ApplicationSubmitted" />
    <bpmn:messageFlow id="MessageFlow_Result" name="اعلان درون‌برنامه‌ای و ایمیل نتیجه بررسی"
                      sourceRef="Task_SendResultEmail" targetRef="Event_AwaitReviewResult"
                      messageRef="Message_ReviewResult" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Volunteer" name="فرآیند داوطلب" isExecutable="false">

    <bpmn:startEvent id="StartEvent_SeesMission" name="مشاهده مأموریت منتشرشده در فهرست مأموریت‌های موجود">
      <bpmn:outgoing>FlowV_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SubmitApplication" name="ارسال درخواست همکاری همراه با پیام توضیحی">
      <bpmn:documentation>داوطلب پس از مطالعه شرح مأموریت، مهارت‌های مورد نیاز و نکات ایمنی درخواست خود را ثبت می‌کند</bpmn:documentation>
      <bpmn:incoming>FlowV_01</bpmn:incoming>
      <bpmn:outgoing>FlowV_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_AwaitReviewResult" name="دریافت اعلان نتیجه بررسی">
      <bpmn:incoming>FlowV_02</bpmn:incoming>
      <bpmn:outgoing>FlowV_03</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Result" messageRef="Message_ReviewResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ReviewResult" name="نتیجه بررسی چیست" default="FlowV_08">
      <bpmn:incoming>FlowV_03</bpmn:incoming>
      <bpmn:outgoing>FlowV_04</bpmn:outgoing>
      <bpmn:outgoing>FlowV_06</bpmn:outgoing>
      <bpmn:outgoing>FlowV_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ReviewAssignment" name="مشاهده تخصیص در انتظار و ثبت پذیرش">
      <bpmn:incoming>FlowV_04</bpmn:incoming>
      <bpmn:outgoing>FlowV_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Assigned" name="داوطلب به مأموریت تخصیص یافت">
      <bpmn:incoming>FlowV_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:receiveTask id="Task_WaitInWaitlist" name="ماندن در فهرست انتظار تا آزادسازی ظرفیت">
      <bpmn:incoming>FlowV_06</bpmn:incoming>
      <bpmn:outgoing>FlowV_07</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:endEvent id="EndEvent_Waitlisted" name="داوطلب در فهرست انتظار ماند">
      <bpmn:incoming>FlowV_07</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_SearchAnotherMission" name="مطالعه دلیل رد و جست‌وجوی مأموریت دیگر">
      <bpmn:incoming>FlowV_08</bpmn:incoming>
      <bpmn:outgoing>FlowV_09</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="درخواست رد شد">
      <bpmn:incoming>FlowV_09</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="FlowV_01" sourceRef="StartEvent_SeesMission" targetRef="Task_SubmitApplication" />
    <bpmn:sequenceFlow id="FlowV_02" sourceRef="Task_SubmitApplication" targetRef="Event_AwaitReviewResult" />
    <bpmn:sequenceFlow id="FlowV_03" sourceRef="Event_AwaitReviewResult" targetRef="Gateway_ReviewResult" />
    <bpmn:sequenceFlow id="FlowV_04" name="تأیید" sourceRef="Gateway_ReviewResult" targetRef="Task_ReviewAssignment" />
    <bpmn:sequenceFlow id="FlowV_05" sourceRef="Task_ReviewAssignment" targetRef="EndEvent_Assigned" />
    <bpmn:sequenceFlow id="FlowV_06" name="فهرست انتظار" sourceRef="Gateway_ReviewResult" targetRef="Task_WaitInWaitlist" />
    <bpmn:sequenceFlow id="FlowV_07" sourceRef="Task_WaitInWaitlist" targetRef="EndEvent_Waitlisted" />
    <bpmn:sequenceFlow id="FlowV_08" name="رد" sourceRef="Gateway_ReviewResult" targetRef="Task_SearchAnotherMission" />
    <bpmn:sequenceFlow id="FlowV_09" sourceRef="Task_SearchAnotherMission" targetRef="EndEvent_Rejected" />

  </bpmn:process>

  <bpmn:process id="Process_Panah" name="فرآیند بررسی درخواست در سامانه پناه" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Panah">
      <bpmn:lane id="Lane_Api" name="سرویس API">
        <bpmn:flowNodeRef>Event_ApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateAndPersist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCoordinator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CapacityAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersistDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="هماهنگ‌کننده">
        <bpmn:flowNodeRef>Task_OpenApplicationInbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateVolunteer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Worker" name="کارگر نامتقارن">
        <bpmn:flowNodeRef>Task_SendResultEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReviewCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_ApplicationReceived" name="دریافت درخواست همکاری">
      <bpmn:outgoing>FlowP_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Application" messageRef="Message_ApplicationSubmitted" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ValidateAndPersist" name="اعتبارسنجی و ثبت درخواست با وضعیت ارسال‌شده">
      <bpmn:documentation>بررسی وضعیت مأموریت و پرچم پذیرش درخواست، بررسی قید یکتایی جفت مأموریت و داوطلب و درج رکورد درخواست و رکورد حسابرسی</bpmn:documentation>
      <bpmn:incoming>FlowP_01</bpmn:incoming>
      <bpmn:outgoing>FlowP_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_NotifyCoordinator" name="اعلان درخواست جدید به هماهنگ‌کننده مأموریت">
      <bpmn:incoming>FlowP_02</bpmn:incoming>
      <bpmn:outgoing>FlowP_03</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_OpenApplicationInbox" name="باز کردن کارتابل درخواست‌های مأموریت">
      <bpmn:incoming>FlowP_03</bpmn:incoming>
      <bpmn:outgoing>FlowP_04</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EvaluateVolunteer" name="ارزیابی مهارت، سابقه و دسترس‌پذیری داوطلب">
      <bpmn:documentation>مقایسه مهارت‌های ثبت‌شده داوطلب با مهارت‌های الزامی مأموریت و بررسی بازه دسترس‌پذیری و سابقه همکاری</bpmn:documentation>
      <bpmn:incoming>FlowP_04</bpmn:incoming>
      <bpmn:outgoing>FlowP_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="تصمیم بررسی‌کننده" default="FlowP_07">
      <bpmn:incoming>FlowP_05</bpmn:incoming>
      <bpmn:outgoing>FlowP_06</bpmn:outgoing>
      <bpmn:outgoing>FlowP_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_CapacityAvailable" name="ظرفیت آزاد در مأموریت وجود دارد" default="FlowP_09">
      <bpmn:incoming>FlowP_06</bpmn:incoming>
      <bpmn:outgoing>FlowP_08</bpmn:outgoing>
      <bpmn:outgoing>FlowP_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_PersistDecision" name="ثبت تصمیم بررسی و ایجاد تخصیص در صورت تأیید">
      <bpmn:documentation>به‌روزرسانی وضعیت درخواست به approved یا waitlist یا rejected همراه با ثبت بررسی‌کننده، زمان بررسی و یادداشت و درج رکورد تخصیص با وضعیت pending برای درخواست تأییدشده</bpmn:documentation>
      <bpmn:incoming>FlowP_07</bpmn:incoming>
      <bpmn:incoming>FlowP_08</bpmn:incoming>
      <bpmn:incoming>FlowP_09</bpmn:incoming>
      <bpmn:outgoing>FlowP_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SendResultEmail" name="ارسال ایمیل نتیجه بررسی به داوطلب">
      <bpmn:documentation>پردازش وظیفه صف Redis توسط کارگر Celery و ارسال ایمیل با تلاش مجدد تا سه بار در صورت خطای تحویل</bpmn:documentation>
      <bpmn:incoming>FlowP_10</bpmn:incoming>
      <bpmn:outgoing>FlowP_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ReviewCompleted" name="بررسی درخواست پایان یافت">
      <bpmn:incoming>FlowP_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="FlowP_01" sourceRef="Event_ApplicationReceived" targetRef="Task_ValidateAndPersist" />
    <bpmn:sequenceFlow id="FlowP_02" sourceRef="Task_ValidateAndPersist" targetRef="Task_NotifyCoordinator" />
    <bpmn:sequenceFlow id="FlowP_03" sourceRef="Task_NotifyCoordinator" targetRef="Task_OpenApplicationInbox" />
    <bpmn:sequenceFlow id="FlowP_04" sourceRef="Task_OpenApplicationInbox" targetRef="Task_EvaluateVolunteer" />
    <bpmn:sequenceFlow id="FlowP_05" sourceRef="Task_EvaluateVolunteer" targetRef="Gateway_ReviewDecision" />
    <bpmn:sequenceFlow id="FlowP_06" name="داوطلب واجد شرایط است" sourceRef="Gateway_ReviewDecision" targetRef="Gateway_CapacityAvailable" />
    <bpmn:sequenceFlow id="FlowP_07" name="رد درخواست" sourceRef="Gateway_ReviewDecision" targetRef="Task_PersistDecision" />
    <bpmn:sequenceFlow id="FlowP_08" name="ظرفیت آزاد است و درخواست تأیید می‌شود" sourceRef="Gateway_CapacityAvailable" targetRef="Task_PersistDecision" />
    <bpmn:sequenceFlow id="FlowP_09" name="ظرفیت تکمیل است و درخواست به فهرست انتظار می‌رود" sourceRef="Gateway_CapacityAvailable" targetRef="Task_PersistDecision" />
    <bpmn:sequenceFlow id="FlowP_10" sourceRef="Task_PersistDecision" targetRef="Task_SendResultEmail" />
    <bpmn:sequenceFlow id="FlowP_11" sourceRef="Task_SendResultEmail" targetRef="EndEvent_ReviewCompleted" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ApplicationReview">
    <bpmndi:BPMNPlane id="BPMNPlane_ApplicationReview" bpmnElement="Collaboration_ApplicationReview">

      <bpmndi:BPMNShape id="Shape_Participant_Volunteer" bpmnElement="Participant_Volunteer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1800" height="340" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_SeesMission" bpmnElement="StartEvent_SeesMission">
        <dc:Bounds x="242" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="222" y="175" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_SubmitApplication" bpmnElement="Task_SubmitApplication">
        <dc:Bounds x="330" y="110" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_AwaitReviewResult" bpmnElement="Event_AwaitReviewResult">
        <dc:Bounds x="1120" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="175" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ReviewResult" bpmnElement="Gateway_ReviewResult" isMarkerVisible="true">
        <dc:Bounds x="1230" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="95" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ReviewAssignment" bpmnElement="Task_ReviewAssignment">
        <dc:Bounds x="1370" y="110" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Assigned" bpmnElement="EndEvent_Assigned">
        <dc:Bounds x="1600" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1580" y="175" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_WaitInWaitlist" bpmnElement="Task_WaitInWaitlist">
        <dc:Bounds x="1370" y="220" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Waitlisted" bpmnElement="EndEvent_Waitlisted">
        <dc:Bounds x="1600" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1580" y="285" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_SearchAnotherMission" bpmnElement="Task_SearchAnotherMission">
        <dc:Bounds x="1370" y="320" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Rejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1600" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1580" y="385" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_Panah" bpmnElement="Participant_Panah" isHorizontal="true">
        <dc:Bounds x="160" y="480" width="1800" height="540" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Api" bpmnElement="Lane_Api" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1770" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Coordinator" bpmnElement="Lane_Coordinator" isHorizontal="true">
        <dc:Bounds x="190" y="660" width="1770" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Worker" bpmnElement="Lane_Worker" isHorizontal="true">
        <dc:Bounds x="190" y="840" width="1770" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_ApplicationReceived" bpmnElement="Event_ApplicationReceived">
        <dc:Bounds x="330" y="552" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="310" y="595" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ValidateAndPersist" bpmnElement="Task_ValidateAndPersist">
        <dc:Bounds x="430" y="530" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_NotifyCoordinator" bpmnElement="Task_NotifyCoordinator">
        <dc:Bounds x="630" y="530" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_OpenApplicationInbox" bpmnElement="Task_OpenApplicationInbox">
        <dc:Bounds x="630" y="710" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_EvaluateVolunteer" bpmnElement="Task_EvaluateVolunteer">
        <dc:Bounds x="830" y="710" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ReviewDecision" bpmnElement="Gateway_ReviewDecision" isMarkerVisible="true">
        <dc:Bounds x="1030" y="725" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1010" y="782" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_CapacityAvailable" bpmnElement="Gateway_CapacityAvailable" isMarkerVisible="true">
        <dc:Bounds x="1030" y="545" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1010" y="495" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_PersistDecision" bpmnElement="Task_PersistDecision">
        <dc:Bounds x="1180" y="530" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_SendResultEmail" bpmnElement="Task_SendResultEmail">
        <dc:Bounds x="1180" y="890" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_ReviewCompleted" bpmnElement="EndEvent_ReviewCompleted">
        <dc:Bounds x="1420" y="912" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1400" y="955" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_FlowV_01" bpmnElement="FlowV_01">
        <di:waypoint x="278" y="150" />
        <di:waypoint x="330" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_02" bpmnElement="FlowV_02">
        <di:waypoint x="480" y="150" />
        <di:waypoint x="1120" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_03" bpmnElement="FlowV_03">
        <di:waypoint x="1156" y="150" />
        <di:waypoint x="1230" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_04" bpmnElement="FlowV_04">
        <di:waypoint x="1280" y="150" />
        <di:waypoint x="1370" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1290" y="120" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_05" bpmnElement="FlowV_05">
        <di:waypoint x="1520" y="150" />
        <di:waypoint x="1600" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_06" bpmnElement="FlowV_06">
        <di:waypoint x="1255" y="175" />
        <di:waypoint x="1255" y="260" />
        <di:waypoint x="1370" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1262" y="205" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_07" bpmnElement="FlowV_07">
        <di:waypoint x="1520" y="260" />
        <di:waypoint x="1600" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_08" bpmnElement="FlowV_08">
        <di:waypoint x="1255" y="175" />
        <di:waypoint x="1255" y="360" />
        <di:waypoint x="1370" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1262" y="320" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowV_09" bpmnElement="FlowV_09">
        <di:waypoint x="1520" y="360" />
        <di:waypoint x="1600" y="360" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_FlowP_01" bpmnElement="FlowP_01">
        <di:waypoint x="366" y="570" />
        <di:waypoint x="430" y="570" />
