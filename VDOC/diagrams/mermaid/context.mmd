%% دیاگرام زمینه سامانه پناه - سطح یک مدل C4
%% موضوع: مرزهای سامانه، بازیگران انسانی و سامانه‌های بیرونی
C4Context
    title دیاگرام زمینه سامانه مدیریت بحران و داوطلبان پناه

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

    Person(volunteer, "داوطلب", "شهروند ثبت‌نام‌شده که مأموریت‌های منتشرشده را می‌بیند، درخواست همکاری می‌دهد و در محل حضور خود را ثبت می‌کند")
    Person(coordinator, "هماهنگ‌کننده", "کارشناس ستاد بحران که رویداد و مأموریت می‌سازد، درخواست‌ها را بررسی و داوطلبان را تخصیص می‌دهد")
    Person(admin, "مدیر سامانه", "مدیر ارشد با دسترسی کامل به کاربران، نقش‌ها، مجوزها و گزارش حسابرسی")

    Enterprise_Boundary(org, "سازمان مدیریت بحران") {
        System(panah, "سامانه پناه", "سامانه وب یکپارچه برای ثبت رویداد بحران، مدیریت پروفایل و مهارت داوطلبان، چرخه عمر مأموریت، تخصیص نیرو، گزارش‌دهی و حسابرسی")
    }

    System_Ext(smtp, "سرویس ایمیل SMTP", "ارسال ایمیل اعلان، تأیید حساب و بازیابی گذرواژه. در محیط توسعه با MailHog جایگزین می‌شود")
    System_Ext(sms, "درگاه پیامک", "ارسال پیام کوتاه فوری به داوطلبان بحرانی. برنامه‌ریزی‌شده برای نسخه‌های آینده")
    System_Ext(idp, "سرویس هویت سازمانی", "احراز هویت یکپارچه سازمانی بر پایه OpenID Connect. برنامه‌ریزی‌شده برای نسخه‌های آینده")

    Rel(volunteer, panah, "ثبت‌نام، تکمیل پروفایل و مهارت، مشاهده مأموریت‌های موجود، ارسال درخواست، ثبت حضور", "HTTPS")
    Rel(coordinator, panah, "ثبت رویداد بحران، ساخت و انتشار مأموریت، بررسی درخواست‌ها، تخصیص داوطلب، ثبت گزارش", "HTTPS")
    Rel(admin, panah, "مدیریت کاربران، نقش‌ها و مجوزها، مشاهده داشبورد و گزارش حسابرسی", "HTTPS")

    Rel(panah, smtp, "ارسال اعلان ایمیلی رویدادهای مأموریت و حساب کاربری", "SMTP")
    Rel(panah, sms, "ارسال اعلان فوری بحران", "HTTPS/REST")
    Rel(panah, idp, "درخواست احراز هویت و دریافت توکن هویت", "OIDC")

    Rel_Back(volunteer, panah, "اعلان درون‌برنامه‌ای و ایمیل درباره نتیجه درخواست و تخصیص")
    Rel_Back(coordinator, panah, "اعلان درخواست‌های جدید و تغییر وضعیت تخصیص‌ها")

    UpdateElementStyle(panah, $bgColor="#0B6E4F", $fontColor="#FFFFFF", $borderColor="#084C37")
    UpdateRelStyle(volunteer, panah, $offsetY="-30", $offsetX="-40")
    UpdateRelStyle(coordinator, panah, $offsetY="-20")
    UpdateRelStyle(admin, panah, $offsetY="-30", $offsetX="30")
