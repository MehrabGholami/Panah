%% دیاگرام فعالیت چرخه عمر مأموریت در سامانه پناه
%% از ثبت رویداد بحران تا بستن مأموریت و بازبینی گزارش
flowchart TD
    START([شروع]) --> A1["ثبت رویداد بحران توسط هماهنگ‌کننده"]
    A1 --> A2["تعیین نوع، شدت، موقعیت و نیازهای رویداد"]
    A2 --> A3["ایجاد مأموریت در وضعیت پیش‌نویس"]
    A3 --> A4["تکمیل عنوان، شرح، زمان‌بندی و تعداد نیروی مورد نیاز"]
    A4 --> A5["تعیین مهارت‌های الزامی و اختیاری مأموریت"]
    A5 --> A6["ثبت ملاحظات ویژه، تجهیزات و نکات ایمنی"]
    A6 --> D1{"اطلاعات مأموریت کامل و معتبر است"}
    D1 -- خیر --> A7["نمایش خطاهای اعتبارسنجی"]
    A7 --> A4
    D1 -- بله --> D2{"مأموریت برای داوطلبان منتشر شود"}
    D2 -- خیر --> A8["نگه‌داشتن مأموریت در پیش‌نویس"]
    A8 --> END1([پایان موقت])
    D2 -- بله --> A9["تغییر وضعیت به منتشرشده و فعال‌سازی پرچم نمایش و پذیرش درخواست"]

    A9 --> A10["انتشار اعلان مأموریت جدید برای داوطلبان واجد شرایط"]
    A10 --> FORK1[/"شروع اجرای همروند"/]

    FORK1 --> B1["مشاهده مأموریت توسط داوطلب"]
    B1 --> B2["ارسال درخواست همکاری همراه با پیام"]
    B2 --> B3["ثبت درخواست در وضعیت ارسال‌شده"]

    FORK1 --> C1["پایش کارتابل درخواست‌ها توسط هماهنگ‌کننده"]

    B3 --> C1
    C1 --> C2["بررسی مهارت، سابقه و دسترس‌پذیری داوطلب"]
    C2 --> D3{"نتیجه بررسی درخواست"}
    D3 -- "تأیید" --> C3["تغییر وضعیت درخواست به تأییدشده"]
    D3 -- "فهرست انتظار" --> C4["تغییر وضعیت درخواست به فهرست انتظار"]
    D3 -- "رد" --> C5["تغییر وضعیت درخواست به ردشده همراه با یادداشت بررسی"]
    C5 --> C6["ارسال اعلان رد درخواست"]
    C6 --> JOIN1
    C4 --> C7["ارسال اعلان فهرست انتظار"]
    C7 --> D4{"ظرفیت آزاد شد"}
    D4 -- بله --> C3
    D4 -- خیر --> JOIN1

    C3 --> A11["ایجاد رکورد تخصیص در وضعیت در انتظار"]
    A11 --> A12["ارسال اعلان تخصیص به داوطلب"]
    A12 --> D5{"داوطلب تخصیص را می‌پذیرد"}
    D5 -- خیر --> A13["ثبت وضعیت رد تخصیص و آزادسازی ظرفیت"]
    A13 --> D4
    D5 -- بله --> A14["ثبت وضعیت پذیرش تخصیص"]

    A14 --> D6{"ظرفیت مورد نیاز مأموریت تکمیل شد"}
    D6 -- خیر --> C1
    D6 -- بله --> A15["تغییر وضعیت مأموریت به در حال اجرا"]

    A15 --> A16["حضور داوطلب در محل و ثبت وضعیت حضوریافته"]
    A16 --> A17["اجرای عملیات میدانی"]
    A17 --> A18["ثبت وضعیت انجام‌شده برای تخصیص"]
    A18 --> D7{"همه تخصیص‌ها تعیین وضعیت شدند"}
    D7 -- خیر --> A16
    D7 -- بله --> A19["تغییر وضعیت مأموریت به تکمیل‌شده"]

    A19 --> A20["ثبت گزارش مأموریت در وضعیت پیش‌نویس"]
    A20 --> A21["بارگذاری پیوست‌های گزارش"]
    A21 --> A22["ارسال گزارش برای بازبینی"]
    A22 --> D8{"گزارش تأیید می‌شود"}
    D8 -- خیر --> A23["بازگرداندن گزارش برای اصلاح"]
    A23 --> A20
    D8 -- بله --> A24["ثبت وضعیت بازبینی‌شده برای گزارش"]
    A24 --> A25["به‌روزرسانی شاخص‌های داشبورد و ثبت رکورد حسابرسی"]
    A25 --> A26["تغییر وضعیت مأموریت به بسته‌شده"]
    A26 --> JOIN1[/"پایان اجرای همروند"/]
    JOIN1 --> END2([پایان])

    classDef decision fill:#FFF4E5,stroke:#B26A00,color:#3D2400
    classDef action fill:#F4FBF7,stroke:#0B6E4F,color:#0A2B20
    classDef terminal fill:#E8F1FF,stroke:#2A5DA8,color:#10243F
    class D1,D2,D3,D4,D5,D6,D7,D8 decision
    class START,END1,END2 terminal
