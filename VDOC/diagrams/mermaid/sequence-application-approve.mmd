%% دیاگرام توالی بررسی و تأیید درخواست همکاری داوطلب در مأموریت
%% نقش بررسی‌کننده: هماهنگ‌کننده یا مدیر سامانه
sequenceDiagram
    autonumber
    actor C as هماهنگ‌کننده
    actor V as داوطلب
    participant SPA as کلاینت وب React
    participant NG as دروازه Nginx
    participant API as سرویس Django REST
    participant MS as سرویس مأموریت
    participant AsS as سرویس تخصیص
    participant NS as سرویس اعلان
    participant DB as پایگاه داده PostgreSQL
    participant RD as صف Redis
    participant WK as کارگر Celery
    participant MAIL as سرویس ایمیل SMTP

    V->>SPA: ارسال درخواست همکاری برای مأموریت منتشرشده
    SPA->>NG: POST /api/v1/missions/{id}/applications/
    NG->>API: هدایت درخواست
    API->>MS: ثبت درخواست همکاری
    MS->>DB: درج رکورد درخواست با وضعیت ارسال‌شده
    DB-->>MS: شناسه درخواست
    MS->>NS: ایجاد اعلان درخواست جدید برای هماهنگ‌کننده
    NS->>DB: درج اعلان درون‌برنامه‌ای
    API-->>SPA: پاسخ 201 با نمایه درخواست
    SPA-->>V: نمایش پیام درخواست شما ثبت شد

    C->>SPA: باز کردن کارتابل درخواست‌های مأموریت
    SPA->>NG: GET /api/v1/missions/{id}/applications/
    NG->>API: هدایت درخواست
    API->>DB: بازیابی درخواست‌ها همراه با پروفایل و مهارت داوطلبان
    DB-->>API: فهرست درخواست‌ها
    API-->>SPA: پاسخ 200 با فهرست صفحه‌بندی‌شده
    SPA-->>C: نمایش جدول درخواست‌ها با امکان مقایسه مهارت‌ها

    C->>SPA: انتخاب درخواست و ثبت تصمیم بررسی
    SPA->>NG: PATCH /api/v1/mission-applications/{id}/ با وضعیت هدف و یادداشت
    NG->>API: هدایت درخواست
    API->>API: بررسی مجوز missions.review_application برای کاربر
    API->>MS: اعمال تصمیم بررسی

    alt کاربر مجوز لازم را ندارد
        API-->>SPA: پاسخ 403 با پیام نبود دسترسی
        SPA-->>C: نمایش خطای نبود دسترسی
    else وضعیت درخواست پیش‌تر نهایی شده است
        MS-->>API: خطای گذار وضعیت نامعتبر
        API-->>SPA: پاسخ 409 با پیام تعارض وضعیت
        SPA-->>C: نمایش پیام این درخواست پیش‌تر بررسی شده است
    else تصمیم رد درخواست است
        MS->>DB: به‌روزرسانی وضعیت به ردشده و ثبت بررسی‌کننده و زمان و یادداشت
        MS->>NS: ایجاد اعلان رد درخواست
        NS->>DB: درج اعلان درون‌برنامه‌ای برای داوطلب
        NS->>RD: انتشار وظیفه ارسال ایمیل رد درخواست
        API-->>SPA: پاسخ 200 با نمایه به‌روزشده
        SPA-->>C: نمایش پیام درخواست رد شد
    else تصمیم فهرست انتظار است
        MS->>DB: به‌روزرسانی وضعیت به فهرست انتظار
        MS->>NS: ایجاد اعلان فهرست انتظار
        NS->>DB: درج اعلان درون‌برنامه‌ای برای داوطلب
        API-->>SPA: پاسخ 200 با نمایه به‌روزشده
        SPA-->>C: نمایش پیام داوطلب به فهرست انتظار افزوده شد
    else تصمیم تأیید درخواست است
        MS->>DB: شمارش تخصیص‌های فعال مأموریت برای بررسی ظرفیت
        DB-->>MS: تعداد تخصیص‌های فعال

        alt ظرفیت مأموریت تکمیل است
            MS-->>API: خطای تکمیل ظرفیت مأموریت
            API-->>SPA: پاسخ 422 با پیام نبود ظرفیت آزاد
            SPA-->>C: پیشنهاد قرار دادن داوطلب در فهرست انتظار
        else ظرفیت آزاد وجود دارد
            MS->>DB: به‌روزرسانی وضعیت درخواست به تأییدشده همراه با بررسی‌کننده و زمان
            MS->>AsS: درخواست ایجاد تخصیص برای داوطلب
            AsS->>DB: درج رکورد تخصیص با وضعیت در انتظار و قید یکتایی مأموریت و داوطلب
            DB-->>AsS: شناسه تخصیص
            AsS->>DB: ثبت رکورد حسابرسی تأیید درخواست و ایجاد تخصیص
            AsS->>NS: ایجاد اعلان تخصیص جدید
            NS->>DB: درج اعلان درون‌برنامه‌ای برای داوطلب
            NS->>RD: انتشار وظیفه ارسال ایمیل تخصیص
            API-->>NG: پاسخ 200 با نمایه درخواست و شناسه تخصیص
            NG-->>SPA: بازگرداندن پاسخ
            SPA->>SPA: بی‌اعتبارسازی حافظه نهان پرسمان‌های مأموریت و درخواست‌ها
            SPA-->>C: نمایش پیام درخواست تأیید و تخصیص ایجاد شد
        end
    end

    RD->>WK: تحویل وظیفه ارسال ایمیل به کارگر
    WK->>DB: بازیابی نشانی رایانامه و متن قالب اعلان
    DB-->>WK: داده مورد نیاز پیام
    WK->>MAIL: ارسال ایمیل نتیجه بررسی درخواست
    MAIL-->>WK: تأیید تحویل به کارساز ایمیل
    WK->>DB: ثبت وضعیت ارسال اعلان

    V->>SPA: مشاهده اعلان و بررسی تخصیص
    SPA->>NG: GET /api/v1/assignments/mine/
    NG->>API: هدایت درخواست
    API->>DB: بازیابی تخصیص‌های داوطلب
    DB-->>API: فهرست تخصیص‌ها
    API-->>SPA: پاسخ 200 با فهرست تخصیص‌ها
    SPA-->>V: نمایش تخصیص در انتظار همراه با گزینه پذیرش یا رد
