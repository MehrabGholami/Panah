%% روندنمای ثبت‌نام داوطلب در سامانه پناه
%% از ورود به صفحه ثبت‌نام تا فعال‌سازی حساب و آماده شدن برای دریافت مأموریت
flowchart TD
    S([ورود کاربر مهمان به صفحه ثبت‌نام]) --> F1["نمایش فرم ثبت‌نام فارسی راست‌چین"]
    F1 --> F2["دریافت نام، نام خانوادگی، رایانامه، شماره تماس، کد ملی و گذرواژه"]
    F2 --> F3["پذیرش شرایط استفاده و بیانیه حفاظت از داده شخصی"]
    F3 --> V1{"اعتبارسنجی سمت کلاینت موفق است"}
    V1 -- خیر --> E1["نمایش خطای میدانی زیر هر ورودی"]
    E1 --> F2
    V1 -- بله --> R1["ارسال درخواست POST به مسیر api/v1/auth/register"]

    R1 --> RL{"محدودسازی نرخ درخواست عبور می‌کند"}
    RL -- خیر --> E2["پاسخ 429 و نمایش پیام تعداد تلاش بیش از حد مجاز"]
    E2 --> W1["انتظار کاربر تا پایان بازه محدودسازی"]
    W1 --> F2
    RL -- بله --> V2{"اعتبارسنجی سمت کارساز موفق است"}

    V2 -- خیر --> E3["پاسخ 400 با فهرست خطاهای میدانی"]
    E3 --> F2
    V2 -- بله --> U1{"رایانامه یا کد ملی پیش‌تر ثبت شده است"}
    U1 -- بله --> E4["پاسخ 409 و نمایش پیام حساب تکراری همراه با پیوند بازیابی گذرواژه"]
    E4 --> D1{"کاربر بازیابی گذرواژه را انتخاب می‌کند"}
    D1 -- بله --> P1["هدایت به فرآیند بازیابی گذرواژه"]
    P1 --> ENDA([پایان مسیر جایگزین])
    D1 -- خیر --> F2

    U1 -- خیر --> T1["آغاز تراکنش پایگاه داده"]
    T1 --> C1["ایجاد رکورد کاربر با پرچم تأییدنشده و درهم‌سازی گذرواژه"]
    C1 --> C2["ایجاد پروفایل داوطلبی با وضعیت در انتظار تأیید"]
    C2 --> C3["انتساب نقش داوطلب به کاربر"]
    C3 --> C4["ثبت رکورد حسابرسی ثبت‌نام"]
    C4 --> T2{"تراکنش با موفقیت پایان یافت"}
    T2 -- خیر --> E5["بازگردانی تراکنش و پاسخ 500 با شناسه همبستگی خطا"]
    E5 --> F2
    T2 -- بله --> N1["انتشار وظیفه ارسال ایمیل خوش‌آمد در صف Redis"]

    N1 --> N2["پردازش وظیفه توسط کارگر Celery و ارسال ایمیل"]
    N2 --> N3["ایجاد اعلان درون‌برنامه‌ای برای هماهنگ‌کنندگان درباره داوطلب جدید"]
    N3 --> RESP["پاسخ 201 به کلاینت"]
    RESP --> M1["نمایش پیام ثبت‌نام شما انجام شد و در انتظار تأیید است"]

    M1 --> A1["بررسی درخواست توسط هماهنگ‌کننده یا مدیر در فهرست داوطلبان"]
    A1 --> A2["راست‌آزمایی هویت، کد ملی و اطلاعات تماس"]
    A2 --> A3{"تصمیم بررسی‌کننده"}
    A3 -- "رد" --> RJ1["تغییر وضعیت پروفایل به ردشده و ثبت دلیل"]
    RJ1 --> RJ2["ارسال اعلان و ایمیل رد ثبت‌نام"]
    RJ2 --> ENDB([پایان با نتیجه رد])
    A3 -- "نیاز به اصلاح" --> RQ1["ارسال درخواست تکمیل مدارک به داوطلب"]
    RQ1 --> RQ2["ویرایش اطلاعات توسط داوطلب"]
    RQ2 --> A1
    A3 -- "تأیید" --> AP1["فعال‌سازی پرچم تأیید حساب کاربر"]
    AP1 --> AP2["تغییر وضعیت پروفایل داوطلبی به فعال"]
    AP2 --> AP3["ثبت رکورد حسابرسی تأیید حساب"]
    AP3 --> AP4["ارسال اعلان و ایمیل تأیید حساب"]

    AP4 --> L1["ورود داوطلب با رایانامه و گذرواژه"]
    L1 --> L2["تکمیل پروفایل شخصی شامل تحصیلات، تماس اضطراری و شرایط پزشکی"]
    L2 --> L3["ثبت مهارت‌ها همراه با سطح تخصص"]
    L3 --> L4["اعلام بازه‌های دسترس‌پذیری"]
    L4 --> L5{"پروفایل به حد کمینه کامل بودن رسید"}
    L5 -- خیر --> L6["نمایش نشانگر درصد تکمیل و راهنمای گام بعد"]
    L6 --> L2
    L5 -- بله --> G1["نمایش مأموریت‌های منتشرشده متناسب با مهارت و موقعیت داوطلب"]
    G1 --> ENDC([پایان با آمادگی دریافت مأموریت])

    classDef decision fill:#FFF4E5,stroke:#B26A00,color:#3D2400
    classDef error fill:#FDECEC,stroke:#B3261E,color:#410E0B
    classDef terminal fill:#E8F1FF,stroke:#2A5DA8,color:#10243F
    classDef ok fill:#F4FBF7,stroke:#0B6E4F,color:#0A2B20
    class V1,V2,U1,D1,T2,A3,L5,RL decision
    class E1,E2,E3,E4,E5,RJ1,RJ2 error
    class S,ENDA,ENDB,ENDC terminal
    class AP1,AP2,AP3,AP4,G1 ok
