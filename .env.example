# Copy to .env for local development
COMPOSE_PROJECT_NAME=volunteer-management

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate a long random value before any non-local deployment.
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,volunteer-management-backend,volunteer-management-nginx
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Database (development defaults — change for shared/staging/production)
POSTGRES_DB=volunteer_management
POSTGRES_USER=volunteer_user
POSTGRES_PASSWORD=volunteer_pass
POSTGRES_HOST=volunteer-management-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://volunteer_user:volunteer_pass@volunteer-management-postgres:5432/volunteer_management

# Redis
REDIS_URL=redis://volunteer-management-redis:6379/0
CELERY_BROKER_URL=redis://volunteer-management-redis:6379/1
CELERY_RESULT_BACKEND=redis://volunteer-management-redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (dev uses Mailhog)
EMAIL_HOST=volunteer-management-mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=noreply@volunteer-management.local

# Development seed credentials (used by seed_data / seed_demo — NOT for production)
ADMIN_EMAIL=Investicaco@gmail.com
ADMIN_PASSWORD=ADMIN
SEED_PASSWORD=SeedPass123!

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=پناه

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Host ports (change any of these if you get a "port is already allocated" or
# "bind: ... forbidden by its access permissions" error on `docker compose up`.
# The second error is common on Windows when port 80/443 falls inside a Hyper-V/
# WSL2 reserved port range, or another app such as IIS/Skype already owns it.
# Just pick a free port here, e.g. HTTP_PORT=8080, and open http://localhost:8080)
HTTP_PORT=80
HTTPS_PORT=443
PGADMIN_PORT=5050
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025
