# Copy to project root as .env for production deployment
COMPOSE_PROJECT_NAME=volunteer-management

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-long-random-production-secret-key
DEBUG=0
ALLOWED_HOSTS=example.com,www.example.com,volunteer-management-backend
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Database
POSTGRES_DB=volunteer_management
POSTGRES_USER=volunteer_user
POSTGRES_PASSWORD=replace-with-strong-production-db-password
POSTGRES_HOST=volunteer-management-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://volunteer_user:replace-with-strong-production-db-password@volunteer-management-postgres:5432/volunteer_management

# Redis
REDIS_URL=redis://volunteer-management-redis:6379/0
CELERY_BROKER_URL=redis://volunteer-management-redis:6379/1
CELERY_RESULT_BACKEND=redis://volunteer-management-redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=پناه

# Security (production)
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
